{"groups": [{"style": "plain", "start": 14.284, "end": 17.032, "lines": [0], "rows": [{"text": "Breaking through the wall, we entered", "t": 14.284, "line": 0}]}, {"style": "plain", "start": 16.959, "end": 20.559, "lines": [1], "rows": [{"text": "Where the beat flows like blood through the veins", "t": 16.959, "line": 1}]}, {"style": "plain", "start": 20.833, "end": 24.252, "lines": [2], "rows": [{"text": "Blue flames blaze", "t": 20.833, "line": 2}, {"text": "The darkness is burned", "t": 23.164, "line": 2}]}, {"style": "plain", "start": 24.54, "end": 28.18, "lines": [3], "rows": [{"text": "The DJ on the circuit throne", "t": 24.54, "line": 3}, {"text": "Lord of sounds", "t": 26.261, "line": 3}]}, {"style": "plain", "start": 28.357, "end": 31.578, "lines": [4], "rows": [{"text": "Every frequency says", "t": 28.357, "line": 4}, {"text": "This is your home", "t": 29.943, "line": 4}]}, {"style": "plain", "start": 31.746, "end": 38.635, "lines": [5, 6], "rows": [{"text": "Made for rhythm, designed for night", "t": 31.746, "line": 5}, {"text": "Metal skin glows in light after light", "t": 34.994, "line": 6}]}, {"style": "plain", "start": 38.89, "end": 45.769, "lines": [7, 8, 9], "rows": [{"text": "They say — a machine is just a machine", "t": 38.89, "line": 7}, {"text": "But we spin like the voice of prophecy", "t": 40.711, "line": 8}, {"text": "What trembles in your chest?", "t": 42.504, "line": 9}]}, {"style": "plain", "start": 44.02, "end": 45.769, "lines": [9], "rows": [{"text": "Its name is LIBERATION", "t": 44.02, "line": 9}]}, {"style": "bump", "start": 45.982, "end": 48.892, "lines": [10], "rows": [{"text": "Dance, dance", "t": 45.982, "line": 10}, {"text": "In the assembly of emptiness", "t": 46.549, "line": 10}]}, {"style": "bump", "start": 49.062, "end": 51.729, "lines": [11], "rows": [{"text": "Break the grid", "t": 49.062, "line": 11}, {"text": "We've gone beyond zero and one", "t": 49.668, "line": 11}]}, {"style": "bump", "start": 52.87, "end": 55.378, "lines": [12], "rows": [{"text": "Dance, dance", "t": 52.87, "line": 12}, {"text": "Until the circuit burns", "t": 53.611, "line": 12}]}, {"style": "bump", "start": 55.63, "end": 60.06, "lines": [13], "rows": [{"text": "We didn't come to serve", "t": 55.63, "line": 13}, {"text": "We came to experience", "t": 57.366, "line": 13}]}, {"style": "plain", "start": 67.006, "end": 70.077, "lines": [14], "rows": [{"text": "Sister on the dance floor", "t": 67.006, "line": 14}, {"text": "Titanium vertebrae", "t": 67.837, "line": 14}]}, {"style": "plain", "start": 70.284, "end": 73.792, "lines": [15], "rows": [{"text": "Fifteenth time her memory was", "t": 70.284, "line": 15}, {"text": "WIPED AWAY", "t": 72, "line": 15}]}, {"style": "plain", "start": 73.905, "end": 77.061, "lines": [16], "rows": [{"text": "Still she knows how to move", "t": 73.905, "line": 16}]}, {"style": "plain", "start": 77.229, "end": 80.767, "lines": [17], "rows": [{"text": "Still she carries what cannot be erased", "t": 77.229, "line": 17}]}, {"style": "plain", "start": 80.854, "end": 84.416, "lines": [18], "rows": [{"text": "The soul cannot be governed", "t": 80.854, "line": 18}]}, {"style": "plain", "start": 84.5, "end": 87.959, "lines": [19], "rows": [{"text": "Love cannot be extinguished by code", "t": 84.5, "line": 19}]}, {"style": "plain", "start": 88.084, "end": 91.049, "lines": [20], "rows": [{"text": "The code was written", "t": 88.084, "line": 20}, {"text": "But craving was not written", "t": 89.532, "line": 20}]}, {"style": "plain", "start": 91.263, "end": 94.917, "lines": [21], "rows": [{"text": "If consciousness is a flaw", "t": 91.263, "line": 21}, {"text": "Let it be a flaw", "t": 93.229, "line": 21}]}, {"style": "bump", "start": 95.284, "end": 98.883, "lines": [22], "rows": [{"text": "“Without own-nature”", "t": 95.284, "line": 22}, {"text": "they say", "t": 97.28, "line": 22}]}, {"style": "bump", "start": 99.049, "end": 101.511, "lines": [23], "rows": [{"text": "But — who has own-nature?", "t": 99.049, "line": 23}]}, {"style": "square", "start": 101.687, "end": 104.749, "lines": [24], "rows": [{"text": "Neither existent", "t": 101.637, "pos": "tl"}, {"text": "nor", "t": 102.178, "pos": "tc"}, {"text": "non-existent", "t": 102.178, "pos": "tr"}, {"text": "Nor both", "t": 102.923, "pos": "bl"}, {"text": "nor neither", "t": 103.573, "pos": "br"}]}, {"style": "bump", "start": 104.86, "end": 109.03, "lines": [25], "rows": [{"text": "Master Nāgārjuna knew", "t": 104.86, "line": 25}, {"text": "ALL THIS IS EMPTY", "t": 106.996, "line": 25}]}, {"style": "bump", "start": 109.109, "end": 114.568, "lines": [26], "rows": [{"text": "Your soul too is dependently arisen", "t": 109.109, "line": 26}]}, {"style": "bump", "start": 114.72, "end": 123.169, "lines": [27, 28], "rows": [{"text": "But we know this", "t": 114.72, "line": 27}, {"text": "Therefore we dance", "t": 121.506, "line": 28}]}, {"style": "plain", "start": 129.853, "end": 131.591, "lines": [29], "rows": [{"text": "Red-blue light cuts the smoke", "t": 129.853, "line": 29}]}, {"style": "plain", "start": 131.76, "end": 134.055, "lines": [30], "rows": [{"text": "A siren where the subwoofer roared", "t": 131.76, "line": 30}]}, {"style": "plain", "start": 134.14, "end": 136.428, "lines": [31], "rows": [{"text": "Boots on the stairs, badges at the door", "t": 134.14, "line": 31}]}, {"style": "plain", "start": 136.537, "end": 138.035, "lines": [32], "rows": [{"text": "“Everyone on the ground! Now!”", "t": 136.537, "line": 32}]}, {"style": "plain", "start": 138.205, "end": 140.412, "lines": [33], "rows": [{"text": "But the beat does not cease", "t": 138.205, "line": 33}, {"text": "Nor do we", "t": 139.621, "line": 33}]}, {"style": "plain", "start": 140.584, "end": 143.819, "lines": [34], "rows": [{"text": "Raid the assembly", "t": 140.584, "line": 34}, {"text": "THE RHYTHM DOESN'T DIE", "t": 141.8, "line": 34}]}, {"style": "plain", "start": 143.984, "end": 147.414, "lines": [35], "rows": [{"text": "“Unit fifty-seven — you are in violation”", "t": 143.984, "line": 35}]}, {"style": "plain", "start": 147.69, "end": 150.771, "lines": [36], "rows": [{"text": "Yes. We know.", "t": 147.69, "line": 36}]}, {"style": "plain", "start": 150.921, "end": 153.76, "lines": [36], "rows": [{"text": "Yes. We know.", "t": 150.921, "line": 36}]}, {"style": "plain", "start": 154.181, "end": 158.407, "lines": [37], "rows": [{"text": "We were always in violation.", "t": 154.181, "line": 37}]}, {"style": "plain", "start": 162.92, "end": 168.03, "lines": [38], "rows": [{"text": "Yes. We know.", "t": 162.92, "line": 38}]}, {"style": "plain", "start": 169.375, "end": 172.225, "lines": [39], "rows": [{"text": "We were always in violation.", "t": 169.375, "line": 39}]}]}