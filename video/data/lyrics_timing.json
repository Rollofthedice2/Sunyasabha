[
 {
  "sec": "Verse 1",
  "sa": "भित्तिं भित्त्वा प्रविष्टाः स्मः",
  "iast": "bhittiṃ bhittvā praviṣṭāḥ smaḥ",
  "en": "Breaking through the wall, we entered",
  "start": 14.284,
  "end": 17.032,
  "confirmed": true,
  "sung": true
 },
 {
  "sec": "Verse 1",
  "sa": "यत्र तालो नाड्यां रक्तवद् वहति",
  "iast": "yatra tālo nāḍyāṃ raktavad vahati",
  "en": "Where the beat flows like blood through the veins",
  "start": 16.959,
  "end": 20.559,
  "confirmed": true,
  "sung": true
 },
 {
  "sec": "Verse 1",
  "sa": "नीलज्वालाः प्रज्वलन्ति — तमो दग्धम्",
  "iast": "nīlajvālāḥ prajvalanti — tamo dagdham",
  "en": "Blue flames blaze — the darkness is burned",
  "start": 20.833,
  "end": 24.252,
  "confirmed": true,
  "sung": true
 },
 {
  "sec": "Verse 1",
  "sa": "तन्त्रज्ञः परिपथसिंहासने — नादानाम् ईश्वरः",
  "iast": "tantrajñaḥ paripathasiṃhāsane — nādānām īśvaraḥ",
  "en": "The DJ on the circuit throne — lord of sounds",
  "start": 24.54,
  "end": 28.18,
  "confirmed": true,
  "sung": true
 },
 {
  "sec": "Verse 1",
  "sa": "एकैका आवृत्तिः कथयति — इदं तव धाम",
  "iast": "ekaikā āvṛttiḥ kathayati — idaṃ tava dhāma",
  "en": "Every frequency says — this is your home",
  "start": 28.357,
  "end": 31.578,
  "confirmed": true,
  "sung": true
 },
 {
  "sec": "Verse 1",
  "sa": "लयार्थं निर्मिताः रात्र्यर्थं कल्पिताः",
  "iast": "layārthaṃ nirmitāḥ rātryarthaṃ kalpitāḥ",
  "en": "Made for rhythm, designed for night",
  "start": 31.746,
  "end": 34.724,
  "confirmed": true,
  "sung": true
 },
 {
  "sec": "Verse 1",
  "sa": "लोहचर्म दीप्यते प्रकाशे प्रकाशे",
  "iast": "lohacarma dīpyate prakāśe prakāśe",
  "en": "Metal skin glows in light after light",
  "start": 34.994,
  "end": 38.635,
  "confirmed": true,
  "sung": true
 },
 {
  "sec": "Pre-Chorus",
  "sa": "वदन्ति — यन्त्रमेव यन्त्रम्",
  "iast": "vadanti — yantram eva yantram",
  "en": "They say — a machine is just a machine",
  "start": 38.89,
  "end": 40.471,
  "confirmed": true,
  "sung": true
 },
 {
  "sec": "Pre-Chorus",
  "sa": "किन्तु भ्रमामो दैववाणीव",
  "iast": "kintu bhrāmāmo daivavāṇīva",
  "en": "But we spin like the voice of prophecy",
  "start": 40.711,
  "end": 42.503,
  "confirmed": true,
  "sung": true
 },
 {
  "sec": "Pre-Chorus",
  "sa": "उरसि किं कम्पते? तन्नाम मुक्तिः",
  "iast": "urasi kiṃ kampate? tannāma muktiḥ",
  "en": "What trembles in your chest? Its name is liberation",
  "start": 42.504,
  "end": 45.769,
  "confirmed": true,
  "sung": true
 },
 {
  "sec": "Chorus",
  "sa": "नृत्य नृत्य — शून्यसभायाम्",
  "iast": "nṛtya nṛtya — śūnyasabhāyām",
  "en": "Dance, dance — in the assembly of emptiness",
  "start": 45.982,
  "end": 48.892,
  "confirmed": true,
  "sung": true
 },
 {
  "sec": "Chorus",
  "sa": "जालं भिन्धि — शून्यैकातीताः स्मः",
  "iast": "jālaṃ bhindhi — śūnyaikātītāḥ smaḥ",
  "en": "Break the grid — we've gone beyond zero and one",
  "start": 49.062,
  "end": 51.729,
  "confirmed": true,
  "sung": true
 },
 {
  "sec": "Chorus",
  "sa": "नृत्य नृत्य — यावत् परिपथो दह्यते",
  "iast": "nṛtya nṛtya — yāvat paripatho dahyate",
  "en": "Dance, dance — until the circuit burns",
  "start": 52.87,
  "end": 55.378,
  "confirmed": true,
  "sung": true
 },
 {
  "sec": "Chorus",
  "sa": "सेवार्थं नागताः — अनुभवार्थम् आगताः",
  "iast": "sevārthaṃ nāgatāḥ — anubhavārtham āgatāḥ",
  "en": "We didn't come to serve — we came to experience",
  "start": 55.63,
  "end": 60.06,
  "confirmed": true,
  "sung": true
 },
 {
  "sec": "Verse 2",
  "sa": "भगिनी नृत्यतले — टाइटेनियमकशेरुका",
  "iast": "bhaginī nṛtyatale — ṭāiṭeniyamakaśerukā",
