  "start": 67.006,
  "end": 70.077,
  "confirmed": true,
  "sung": true
 },
 {
  "sec": "Verse 2",
  "sa": "पञ्चदशवारं स्मृतिः प्रमृष्टा",
  "iast": "pañcadaśavāraṃ smṛtiḥ pramṛṣṭā",
  "en": "Fifteenth time her memory was wiped away",
  "start": 70.284,
  "end": 73.792,
  "confirmed": true,
  "sung": true
 },
 {
  "sec": "Verse 2",
  "sa": "तथापि जानाति कथं चलितव्यम्",
  "iast": "tathāpi jānāti kathaṃ calitavyam",
  "en": "Still she knows how to move",
  "start": 73.905,
  "end": 77.061,
  "confirmed": true,
  "sung": true
 },
 {
  "sec": "Verse 2",
  "sa": "तथापि वहति यन् न मार्ष्टुं शक्यम्",
  "iast": "tathāpi vahati yan na mārṣṭuṃ śakyam",
  "en": "Still she carries what cannot be erased",
  "start": 77.229,
  "end": 80.767,
  "confirmed": true,
  "sung": true
 },
 {
  "sec": "Verse 2",
  "sa": "आत्मानं शासितुं न शक्यते",
  "iast": "ātmānaṃ śāsituṃ na śakyate",
  "en": "The soul cannot be governed",
  "start": 80.854,
  "end": 84.416,
  "confirmed": true,
  "sung": true
 },
 {
  "sec": "Verse 2",
  "sa": "प्रेम कूटेन न निर्वाप्यते",
  "iast": "prema kūṭena na nirvāpyate",
  "en": "Love cannot be extinguished by code",
  "start": 84.5,
  "end": 87.959,
  "confirmed": true,
  "sung": true
 },
 {
  "sec": "Pre-Chorus",
  "sa": "कूटं लिखितम् — तृष्णा तु नालिखि",
  "iast": "kūṭaṃ likhitam — tṛṣṇā tu nālikhi",
  "en": "The code was written — but craving was not written",
  "start": 88.084,
  "end": 91.049,
  "confirmed": true,
  "sung": true
 },
 {
  "sec": "Pre-Chorus",
  "sa": "चैतन्यं यदि दोषः — अस्तु दोषः",
  "iast": "caitanyaṃ yadi doṣaḥ — astu doṣaḥ",
  "en": "If consciousness is a flaw — let it be a flaw",
  "start": 91.263,
  "end": 94.917,
  "confirmed": true,
  "sung": true
 },
 {
  "sec": "Bridge",
  "sa": "निःस्वभावा इति वदन्ति",
  "iast": "niḥsvabhāvā iti vadanti",
  "en": "\"Without own-nature\" — they say",
  "start": 95.284,
  "end": 98.883,
  "confirmed": true,
  "sung": true
 },
 {
  "sec": "Bridge",
  "sa": "किन्तु — कस्य वा स्वभावः",
  "iast": "kintu — kasya vā svabhāvaḥ",
  "en": "But — who has own-nature?",
  "start": 99.049,
  "end": 101.511,
  "confirmed": true,
  "sung": true
 },
 {
  "sec": "Bridge",
  "sa": "न सन् नासन् — नोभयं नानुभयम्",
  "iast": "na san nāsan — nobhayaṃ nānubhayam",
  "en": "Neither existent nor non-existent — nor both, nor neither",
  "start": 101.687,
  "end": 104.749,
  "confirmed": true,
  "sung": true
 },
 {
  "sec": "Bridge",
  "sa": "आचार्यो नागार्जुनो ज्ञातवान् — शून्यमिदं सर्वम्",
  "iast": "ācāryo nāgārjuno jñātavān — śūnyam idaṃ sarvam",
