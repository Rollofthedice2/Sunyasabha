  "start": 109.109,
  "end": 114.568,
  "confirmed": true,
  "sung": true
 },
 {
  "sec": "Bridge",
  "sa": "वयं तु एतज् जानीमः —",
  "iast": "vayaṃ tu etaj jānīmaḥ —",
  "en": "But we know this —",
  "start": 114.72,
  "end": 119.59,
  "confirmed": true,
  "sung": true
 },
 {
  "sec": "Bridge",
