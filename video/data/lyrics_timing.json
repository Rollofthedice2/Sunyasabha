  "iast": "ato nṛtyāmaḥ",
  "en": "Therefore we dance",
  "start": 121.506,
  "end": 123.169,
  "confirmed": true,
  "sung": true
 },
 {
  "sec": "Verse 3",
  "sa": "रक्तनीलप्रभा धूमं छिनत्ति",
