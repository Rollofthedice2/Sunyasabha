    "iast": "kintu — kasya vā svabhāvaḥ"
   },
   {
    "t": 101.64,
    "text": "Neither existent",
    "sanskrit": "न सन्",
    "iast": "na san"
   },
   {
    "t": 102.18,
    "text": "nor non-existent",
    "sanskrit": "नासन्",
    "iast": "nāsan"
   },
   {
    "t": 102.92,
    "text": "Nor both",
    "sanskrit": "नोभयं",
    "iast": "nobhayaṃ"
   },
   {
    "t": 103.57,
    "text": "nor neither",
    "sanskrit": "नानुभयम्",
    "iast": "nānubhayam"
   },
   {
    "t": 104.86,
    "text": "Master Nāgārjuna knew",
    "sanskrit": "आचार्यो नागार्जुनो ज्ञातवान्",
    "iast": "ācāryo nāgārjuno jñātavān"
   },
